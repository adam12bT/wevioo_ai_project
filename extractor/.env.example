# Copy to .env and adjust as needed. Nothing here is a real secret.

# --- Upload limits -----------------------------------------------------
MAX_FILE_SIZE_MB=50

# --- OCR -----------------------------------------------------------------
OCR_LANGUAGE=eng+fra
OCR_ENGINE=tesseract
MIN_NATIVE_TEXT_CHARS=20
OCR_DPI=300

# --- Table extraction ------------------------------------------------
TABLE_EXTRACTION_ENGINE=pdfplumber
SCANNED_TABLE_EXTRACTION_ENABLED=true

# --- AnythingLLM integration ------------------------------------------
# Base URL of your (possibly modified) AnythingLLM instance.
ANYTHINGLLM_URL=https://adambouacida7-ai-cv.hf.space
# Optional. Leave blank if your AnythingLLM instance has API-key auth
# disabled (e.g. a fork with `validApiKey` middleware turned into a no-op).
# If set, it's still sent as a Bearer token, so this also works against a
# stock AnythingLLM instance that does enforce keys.
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_TIMEOUT_SECONDS=60
ANYTHINGLLM_MAX_RETRIES=3
ANYTHINGLLM_RETRY_BACKOFF_SECONDS=0.5
ANYTHINGLLM_ROLLBACK_ON_FAILURE=true

# --- Misc ------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=120
# Leave blank to use the operating system's temporary directory.
TEMP_DIR=
LOG_LEVEL=INFO
