LOG_LEVEL=INFO
REDIS_URL=redis://redis:6379/0
# Hosted Upstash example: rediss://default:PASSWORD@HOST:6379
QUEUE_NAME=rfp-pipeline
JOB_TTL_SECONDS=604800
RESULT_TTL_SECONDS=604800
JOB_TIMEOUT_SECONDS=7200
WORKER_MAX_RETRIES=3
WORKER_RETRY_INTERVALS_SECONDS=10,30,60
REDIS_EVENT_TTL_SECONDS=86400
REDIS_EVENT_MAX_LENGTH=2000
STORAGE_DIR=/data

# Durable metadata database. Use postgres locally and inspect it with pgAdmin.
DATABASE_PROVIDER=postgres
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://rfp_worker:change-me-local-only@postgres:5432/rfp_worker
DATABASE_REQUIRED=true
DATABASE_AUTO_CREATE=true
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-local-only

# Existing agent-pipeline FastAPI service, not AnythingLLM or the extractor.
PIPELINE_BASE_URL=http://host.docker.internal:8000
PIPELINE_API_KEY=
PIPELINE_REQUEST_TIMEOUT_SECONDS=120
PIPELINE_POLL_INTERVAL_SECONDS=10
PIPELINE_RATE_LIMIT_BACKOFF_SECONDS=30
PIPELINE_HEALTH_CACHE_SECONDS=60
PIPELINE_MAX_POLL_SECONDS=7200

# Local mode keeps files in STORAGE_DIR. Supabase Storage is optional locally.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=rfp-files
SUPABASE_REQUIRED=false
SUPABASE_REQUEST_TIMEOUT_SECONDS=120

# Production Supabase database configuration:
# DATABASE_PROVIDER=supabase
# DATABASE_URL=
# SUPABASE_REQUIRED=true

CORS_ORIGINS=http://localhost:5173
